# Server/build variables only. Never commit secrets or prefix them with VITE_.
# Vite loads GROQ_* from .env.local for chat. Other server/build variables
# must be set in the relevant process/hosting environment. See docs/DEPLOY-NOTES.md.

# Jiya: Groq-generated visitor answers (server only)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CHAT_ALLOWED_ORIGINS=

# Enquiry delivery: at least one of email or store must succeed
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=er.sheershtiwari@gmail.com
LEAD_FROM_EMAIL="Sheersh Portfolio <onboarding@resend.dev>"
# For Apps Script, include ?token=... in URL. Keep the URL private.
LEAD_STORE_WEBHOOK_URL=
# Generic webhook Bearer header; not Apps Script auth
LEAD_STORE_WEBHOOK_TOKEN=
LEAD_ALLOWED_ORIGINS=
LEAD_RATE_LIMIT_MAX=5
LEAD_RATE_LIMIT_WINDOW_MS=600000

# Optional Google HTML verification content value. Set in BUILD environment.
GOOGLE_SITE_VERIFICATION=

# Hunter: also uses GROQ_API_KEY, RESEND_API_KEY and webhook above
APIFY_TOKEN=
RECIPIENT_EMAIL=er.sheershtiwari@gmail.com

# Optional local performance-harness Chromium binary
CHROME_PATH=
