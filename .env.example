# ─────────────────────────────────────────────────────────────────────────────
# Sheersh Portfolio — environment variables
# Copy to `.env.local` (or set in the Vercel project) and fill in real values.
# NEVER commit a real value. `.gitignore` blocks `.env`, `.env.*` and `.env.local`.
# Placeholders only — see docs/DEPLOY-NOTES.md for who needs what.
# ─────────────────────────────────────────────────────────────────────────────

# --- /api/lead : REQUIRED -----------------------------------------------------
# Resend API key (same account already used by scripts/lead-hunter.js).
RESEND_API_KEY=re_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxx

# Inbox that receives the lead notification.
LEAD_NOTIFY_EMAIL=er.sheershtiwari@gmail.com

# Verified Resend sender. Until a domain is verified, Resend only allows
# onboarding@resend.dev — see docs/DEPLOY-NOTES.md.
LEAD_FROM_EMAIL=Sheersh Portfolio <onboarding@resend.dev>

# --- /api/lead : OPTIONAL -----------------------------------------------------
# External durable store (Google Apps Script → Google Sheet, CRM, or DB adapter).
# The payload is a normalised row: {"row":[11 strings]} — the same shape the lead
# hunter writes to the same sheet. Schema + 10-minute setup: docs/GOOGLE-SHEET-SETUP.md
# When empty, the lead is persisted in the notification email + structured logs only.
# NOTE: for a Google Apps Script store put "?token=…" inside this URL — Apps Script
# web apps cannot read request headers, so LEAD_STORE_WEBHOOK_TOKEN does nothing there.
# The same URL also belongs in GitHub Actions as the repo secret LEAD_STORE_WEBHOOK_URL.
LEAD_STORE_WEBHOOK_URL=
LEAD_STORE_WEBHOOK_TOKEN=

# Extra browser origins allowed to POST (comma-separated). Preview deploys only.
LEAD_ALLOWED_ORIGINS=

# Rate limit knobs (defaults: 5 submissions / 10 minutes / per IP).
LEAD_RATE_LIMIT_MAX=5
LEAD_RATE_LIMIT_WINDOW_MS=600000

# --- Other server-side scripts (lead-hunter pipeline, untouched) ---------------
GROQ_API_KEY=
APIFY_TOKEN=
RECIPIENT_EMAIL=er.sheershtiwari@gmail.com
